<Project>
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>Umami contributors; Usagirei</Authors>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RepositoryUrl>https://github.com/BakuretsuBaka/UmamiMobile</RepositoryUrl>
    <NoWarn>$(NoWarn);CS1591;CS0618</NoWarn>
  </PropertyGroup>
</Project>
